    def criar_botoes(self):
        self.barra = tk.Frame(self.raiz, bg="#ffffff", padx=20, pady=5)
        self.barra.pack(fill=tk.X, pady=5)
        botoes = [
            (f"📦 {t('novo_produto')}", "#27ae60", self.janela_cadastrar),
            (f"🔄 {t('entrada')}", "#3498db", self.janela_entrada),
            (f"💰 {t('venda')}", "#f39c12", self.janela_vender),
            (f"🗑️ {t('excluir')}", "#e74c3c", self.janela_excluir),
            (f"📊 {t('relatorio')}", "#9b59b6", self.ver_relatorio),
            (f"🔄 {t('atualizar')}", "#95a5a6", self.atualizar_tabela)
        ]
        self.botoes_widgets = []
        for i, (texto, cor, acao) in enumerate(botoes):
            btn = tk.Button(self.barra, text=texto, command=acao, bg=cor, fg="white",
                      font=("Arial", 10, "bold"), padx=15, pady=10)
            btn.grid(row=0, column=i, padx=5)
            self.botoes_widgets.append(btn)

    def criar_tabela(self):
        quadro = tk.Frame(self.raiz, bg="white", padx=10, pady=10)
        quadro.pack(fill=tk.BOTH, expand=True, padx=15, pady=5)
        colunas = (t("codigo"), t("produto"), t("qtd"), t("preco"), t("validade"), t("status"))
        self.tabela = ttk.Treeview(quadro, columns=colunas, show="headings", height=15)
        self.tabela_cols = []
        for col in colunas:
            widg = self.tabela.heading(col, text=col)
            self.tabela.column(col, width=130)
            self.tabela_cols.append(widg)
        self.tabela.pack(fill=tk.BOTH, expand=True)

    def atualizar_tabela(self):
        for item in self.tabela.get_children():
            self.tabela.delete(item)
        dados = carregar()
        texto_pesq = self.ent_pesquisa.get().strip().lower() if hasattr(self, 'ent_pesquisa') else ""

        for p in dados["produtos"]:
            if texto_pesq:
                codigo = str(p.get("codigo", "")).lower()
                nome = p["nome"].lower()
                if texto_pesq not in codigo and texto_pesq not in nome:
                    continue

            status = f"✅ {t('normal')}"
            if p["quantidade"] == 0:
                status = f"🔴 {t('zerado')}"
            elif p["quantidade"] < 10:
                status = f"⚠️ {t('pouco')}"

            self.tabela.insert("", tk.END, values=(
                p.get("codigo", p["id"]),
                p["nome"],
                p["quantidade"],
