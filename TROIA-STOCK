        janela = tk.Toplevel()
        janela.title(f"🗑️ {t('excluir_produto')}")
        janela.geometry("400x250")
        dados = carregar()
        if not dados["produtos"]:
            messagebox.showwarning("⚠️", t("nenhum_produto"))
            janela.destroy()
            return

        tk.Label(janela, text=f"{t('excluir_produto')}:", font=("Arial", 10)).pack(pady=15)
        lista = ttk.Combobox(janela, values=[f"{p.get('codigo', p['id'])} → {p['nome']}" for p in dados["produtos"]], width=45)
        lista.pack(pady=5)

        def apagar():
            if not lista.get():
                messagebox.showwarning("⚠️", t("selecione_produto") + "!")
                return
            try:
                codigo_selecionado = lista.get().split("→")[0].strip()
            except:
                messagebox.showwarning("⚠️", t("valores_invalidos"))
                return

            if messagebox.askyesno("⚠️", t("certeza")):
                dados = carregar()
                for i, p in enumerate(dados["produtos"]):
                    if str(p.get("codigo", p["id"])) == codigo_selecionado:
                        nome = p["nome"]
                        dados["produtos"].pop(i)
                        salvar(dados)
                        messagebox.showinfo("✅", f"{t('excluido')}: {nome}")
                        janela.destroy()
                        self.atualizar_tabela()
                        return

        tk.Button(janela, text=t("excluir"), command=apagar, bg="#e74c3c", fg="white", padx=30, pady=8).pack(pady=20)

    def ver_relatorio(self):
        dados = carregar()
        total_qtd = 0
        total_valor = 0.0
        texto = f"📊 {t('relatorio_vendas')}\n" + "=" * 40 + "\n"
        for p in dados["produtos"]:
            qtd = sum(v["quantidade"] for v in p.get("vendas", []))
            val = sum(v["valor_total"] for v in p.get("vendas", []))
            total_qtd += qtd
            total_valor += val
            if qtd > 0:
                texto += f"\n{p.get('codigo', p['id'])} - {p['nome']}: {qtd} {t('unidades')} → {'R$' if idioma_atual == 'pt' else '$'} {val:.2f}"
        texto += f"\n\n" + "=" * 40
        texto += f"\n💰 {t('total_geral')}: {total_qtd} {t('unidades')} | {'R$' if idioma_atual == 'pt' else '$'} {total_valor:.2f}"
        messagebox.showinfo(f"📊 {t('relatorio')}", texto)

