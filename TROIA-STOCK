        self.btn_cad.grid(row=10, column=0, columnspan=2, pady=15)

    def atualizar_textos(self):
        self.raiz.title(f"📝 {t('criar_conta')} — TROIA")
        self.lbl_titulo.config(text=f"🔥 {t('criar_conta')}")
        self.lbl_user.config(text=f"{t('usuario')}:")
        self.lbl_pass.config(text=f"{t('senha')}:")
        self.lbl_conf.config(text=f"{t('confirma_senha')}:")
        self.btn_cad.config(text=t("cadastrar"))
        if idioma_atual == "pt":
            self.btn_idioma.config(text="🇧🇷 PT")
        else:
            self.btn_idioma.config(text="🇺🇸 EN")

    def mudar_idioma(self):
        trocar_idioma()
        self.atualizar_textos()

    def cadastrar(self, evento=None):
        u = self.ent_usuario.get().strip()
        s = self.ent_senha.get().strip()
        c = self.ent_confirma.get().strip()

        if not u or not s or not c:
            messagebox.showwarning("", t("preencha_todos"))
            return
        if s != c:
            messagebox.showerror("", t("senha_nao_confere"))
            return

        dados = carregar_usuarios()
        if any(x["usuario"] == u for x in dados["usuarios"]):
            messagebox.showerror("", t("usuario_existe"))
            return

        dados["usuarios"].append({"usuario": u, "senha": hash_senha(s)})
        salvar_usuarios(dados)
        messagebox.showinfo("", t("conta_criada"))
        self.raiz.destroy()
        TelaLogin(tk.Tk(), TelaPrincipal)
        self.raiz.mainloop()

