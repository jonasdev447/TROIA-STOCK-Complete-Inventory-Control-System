    def janela_cadastrar(self):
        janela = tk.Toplevel()
        janela.title(f"📦 {t('cadastrar_produto')}")
        janela.geometry("420x480")
        janela.configure(bg="#f9f9f9")

        tk.Label(janela, text=f"{t('codigo_produto')}:", bg="#f9f9f9", font=("Arial", 10)).pack(pady=5)
        ent_codigo = tk.Entry(janela, width=35)
        ent_codigo.pack()

        tk.Label(janela, text=f"{t('nome')}:", bg="#f9f9f9", font=("Arial", 10)).pack(pady=5)
        ent_nome = tk.Entry(janela, width=35)
        ent_nome.pack()

        tk.Label(janela, text=f"{t('quantidade')}:", bg="#f9f9f9", font=("Arial", 10)).pack(pady=5)
        ent_qtd = tk.Entry(janela, width=35)
        ent_qtd.pack()

        tk.Label(janela, text=f"{t('validade')} (DD/MM/AAAA):", bg="#f9f9f9", font=("Arial", 10)).pack(pady=5)
        ent_val = tk.Entry(janela, width=35)
        ent_val.pack()

        tk.Label(janela, text=f"{t('preco_r')}:", bg="#f9f9f9", font=("Arial", 10)).pack(pady=5)
        ent_preco = tk.Entry(janela, width=35)
        ent_preco.pack()

        def salvar_produto():
            codigo = ent_codigo.get().strip()
            nome = ent_nome.get().strip()
            qtd_texto = ent_qtd.get().strip()
            val = ent_val.get().strip()
            preco_texto = ent_preco.get().strip()
            erros = []

            dados = carregar()
            if codigo:
                for p in dados["produtos"]:
                    if str(p.get("codigo", "")).strip() == codigo:
                        erros.append(f"• Código '{codigo}' {t('codigo_existe')}")
                        break

            if not nome or len(nome) < 2:
                erros.append(f"• {t('nome_invalido')}")

            qtd = 0
            if not qtd_texto:
                erros.append(f"• {t('qtd_vazia')}")
            else:
                try:
                    qtd = int(qtd_texto)
                    if qtd < 0:
                        erros.append(f"• {t('qtd_negativa')}")
                except ValueError:
                    erros.append(f"• {t('qtd_apenas_numeros')}")

            if not re.match(r"^\d{2}/\d{2}/\d{4}$", val):
                erros.append(f"• {t('validade_formato')}")

            preco = 0.0
            if not preco_texto:
                erros.append(f"• {t('preco_vazio')}")
            else:
                try:
                    preco = float(preco_texto.replace(",", "."))
                    if preco <= 0:
                        erros.append(f"• {t('preco_maior_zero')}")
                except ValueError:
                    erros.append(f"• {t('preco_invalido')}")

            if erros:
                messagebox.showwarning(f"⚠️ {t('ajustes_dados')}", "\n".join(erros))
                return

            dados["produtos"].append({
                "id": len(dados["produtos"]) + 1,
                "codigo": codigo if codigo else str(len(dados["produtos"]) + 1),
                "nome": nome,
                "quantidade": qtd,
                "validade": val,
                "preco_unitario": preco,
                "vendas": []
            })
            salvar(dados)
            messagebox.showinfo("✅", t("produto_cadastrado"))
            janela.destroy()
            self.atualizar_tabela()

        tk.Button(janela, text=t("salvar"), command=salvar_produto,
                  bg="#27ae60", fg="white", padx=30, pady=8, font=("Arial", 11, "bold")).pack(pady=20)

