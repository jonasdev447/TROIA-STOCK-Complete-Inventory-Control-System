    def janela_vender(self):
        janela = tk.Toplevel()
        janela.title(f"💰 {t('registrar_venda')}")
        janela.geometry("400x320")
        dados = carregar()
        if not dados["produtos"]:
            messagebox.showwarning("⚠️", t("nenhum_produto"))
            janela.destroy()
            return

        tk.Label(janela, text=f"{t('selecione_produto')}:", font=("Arial", 10)).pack(pady=10)
        lista = ttk.Combobox(janela, values=[f"{p.get('codigo', p['id'])} → {p['nome']} ({t('qtd')}: {p['quantidade']})" for p in dados["produtos"]], width=50)
        lista.pack(pady=5)

        tk.Label(janela, text=f"{t('qtd_vendida')}:", font=("Arial", 10)).pack(pady=10)
        ent_qtd = tk.Entry(janela, width=20)
        ent_qtd.pack()

        def efetuar_venda():
            if not lista.get():
                messagebox.showwarning("⚠️", t("selecione_produto") + "!")
                return
            try:
                codigo_selecionado = lista.get().split("→")[0].strip()
                qtd = int(ent_qtd.get())
                if qtd <= 0:
                    messagebox.showwarning("⚠️", t("qtd_maior_zero"))
                    return
            except:
                messagebox.showwarning("⚠️", t("valores_invalidos"))
                return

            dados = carregar()
            for p in dados["produtos"]:
                if str(p.get("codigo", p["id"])) == codigo_selecionado:
                    if qtd > p["quantidade"]:
                        messagebox.showerror("❌", f"{t('nao_tem_estoque')} {p['quantidade']}!")
                        return
                    p["quantidade"] -= qtd
                    p["vendas"].append({
                        "data": datetime.now().strftime("%d/%m/%Y %H:%M"),
                        "quantidade": qtd,
                        "valor_total": qtd * p["preco_unitario"]
                    })
                    salvar(dados)
                    messagebox.showinfo("✅", f"{t('venda_registrada')}: {p['quantidade']}")
                    janela.destroy()
                    self.atualizar_tabela()
                    return

        tk.Button(janela, text=t("confirmar"), command=efetuar_venda, bg="#f39c12", fg="white", padx=30, pady=8).pack(pady=20)

