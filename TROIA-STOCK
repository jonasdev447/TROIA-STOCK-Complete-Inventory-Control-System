class TelaLogin:
    def __init__(self, raiz, on_login_sucesso):
        self.raiz = raiz
        self.on_sucesso = on_login_sucesso
        self.raiz.geometry("450x350")
        self.raiz.resizable(False, False)
        self.raiz.configure(bg="#1a1a2e")
        self.criar_tela()
        self.atualizar_textos()

    def criar_tela(self):
        self.lbl_titulo = tk.Label(self.raiz, text="🔥 TROIA ESTOQUE",
                 font=("Arial", 22, "bold"), bg="#1a1a2e", fg="#f5a623")
        self.lbl_titulo.pack(pady=30)

        self.btn_idioma = tk.Button(self.raiz, text="🇧🇷 PT", command=self.mudar_idioma,
                                    bg="#f5a623", fg="white", font=("Arial", 9, "bold"))
        self.btn_idioma.place(relx=0.92, rely=0.02)

        self.caixa = tk.Frame(self.raiz, bg="#ffffff", padx=30, pady=25)
        self.caixa.pack(pady=10)

        self.lbl_user = tk.Label(self.caixa, text="Usuário:", font=("Arial", 11), bg="#ffffff")
        self.lbl_user.grid(row=0, column=0, sticky="w", pady=5)
        self.ent_usuario = tk.Entry(self.caixa, font=("Arial", 11), width=25)
        self.ent_usuario.grid(row=0, column=1, pady=5)
        self.ent_usuario.bind("<Return>", lambda e: self.ent_senha.focus())

        self.lbl_pass = tk.Label(self.caixa, text="Senha:", font=("Arial", 11), bg="#ffffff")
        self.lbl_pass.grid(row=1, column=0, sticky="w", pady=5)
        self.ent_senha = tk.Entry(self.caixa, font=("Arial", 11), width=25, show="●")
        self.ent_senha.grid(row=1, column=1, pady=5)
        self.ent_senha.bind("<Return>", lambda e: self.verificar())

        self.btn_entrar = tk.Button(self.caixa, text="Entrar", command=self.verificar,
                                    bg="#f5a623", fg="white", font=("Arial", 11, "bold"), width=20)
        self.btn_entrar.grid(row=2, column=0, columnspan=2, pady=15)

        self.btn_cadastro = tk.Button(self.caixa, text="Não tem conta? Cadastrar",
                  command=self.ir_cadastro, relief="flat", fg="#3498db")
        self.btn_cadastro.grid(row=3, column=0, columnspan=2)

    def atualizar_textos(self):
        self.raiz.title(f"🔐 {t('titulo_login')}")
        self.lbl_user.config(text=f"{t('usuario')}:")
        self.lbl_pass.config(text=f"{t('senha')}:")
        self.btn_entrar.config(text=t("entrar"))
        self.btn_cadastro.config(text=t("sem_conta"))
        if idioma_atual == "pt":
            self.btn_idioma.config(text="🇧🇷 PT")
        else:
            self.btn_idioma.config(text="🇺🇸 EN")

    def mudar_idioma(self):
        trocar_idioma()
        self.atualizar_textos()

    def verificar(self, evento=None):
        dados = carregar_usuarios()
        usuario = self.ent_usuario.get().strip()
        senha = self.ent_senha.get().strip()

        if not dados["usuarios"]:
            messagebox.showinfo("", t("sem_usuario"))
            return

        for u in dados["usuarios"]:
            if u["usuario"] == usuario and u["senha"] == hash_senha(senha):
                self.raiz.destroy()
                self.on_sucesso()
                return

        messagebox.showerror("", t("login_erro"))

    def ir_cadastro(self):
        self.raiz.destroy()
        TelaCadastro(self.on_sucesso)

